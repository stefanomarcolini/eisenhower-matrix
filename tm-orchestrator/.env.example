# tm-orchestrator — Environment Variables (Docker Compose)
# Copy this file to .env and fill in your local values.
# .env is gitignored and must never be committed.
#
# This file aggregates variables for ALL services managed by docker-compose.
# See ENV_VARS.md in tm-documentation for the authoritative reference.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# "db" is the compose service name — do not change for local dev.
DB_HOST=db
DB_PORT=5432
DB_NAME=taskmanager
DB_USERNAME=tm
DB_PASSWORD=changeme

# ── Core API — JWT ────────────────────────────────────────────────────────────
# HS256 signing key (min 32 bytes, Base64). Generate: openssl rand -base64 32
INTERNAL_JWT_SECRET=your-base64-encoded-secret-here
JWT_EXPIRY_MINUTES=15

# ── Core API — MFA ────────────────────────────────────────────────────────────
# AES-256 key for TOTP secret encryption (Base64, 32 bytes). Generate: openssl rand -base64 32
MFA_ENCRYPTION_KEY=your-base64-encoded-key-here

# ── Core API — Password policy ────────────────────────────────────────────────
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_AGE_WARNING_DAYS=80
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=1

# ── Core API — Email / SMTP ───────────────────────────────────────────────────
EMAIL_FROM_ADDRESS=noreply@task-manager.io
EMAIL_FROM_NAME=Task Manager
# Local dev: Mailpit (compose service name, no credentials, no TLS)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_ENABLED=false
# Public URL for password-reset email links (points to BFF)
APP_BASE_URL=http://localhost:8080

# ── Redis ─────────────────────────────────────────────────────────────────────
# "redis" is the compose service name — do not change for local dev.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── BFF — Session ─────────────────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30
# "core-api" is the compose service name — do not change for local dev.
CORE_API_BASE_URL=http://core-api:8080

# ── OAuth2 ────────────────────────────────────────────────────────────────────
# Not required for local dev — mock-oauth2 compose service handles Google and Microsoft.
# Set real credentials only when testing against live IdPs.
GOOGLE_CLIENT_ID=disabled
GOOGLE_CLIENT_SECRET=disabled
MICROSOFT_CLIENT_ID=disabled
MICROSOFT_CLIENT_SECRET=disabled

# ── Bootstrap admin ───────────────────────────────────────────────────────────
# BCrypt hash of the initial admin password (injected into Liquibase changeset 007).
# Change the admin password immediately after first login via Settings → Security.
#
# Generate (cost 12, production):
#   htpasswd -bnBC 12 "" yourpassword | tr -d ':\n'
#
# Generate (cost 4, faster for local dev):
#   htpasswd -bnBC 4 "" yourpassword | tr -d ':\n'
# Escape $ as $$ in .env so docker compose keeps the full bcrypt hash value.
BOOTSTRAP_ADMIN_BCRYPT_HASH=$$2y$$04$$replacethiswithyourrealbcrypthashvalue00000000000000000
