# tm-db-schema — Environment Variables
# Copy this file to .env and fill in your local values.
# .env is gitignored and must never be committed.

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskmanager
# Must have DDL privileges (CREATE TABLE, ALTER TABLE, etc.)
DB_USERNAME=tm
DB_PASSWORD=changeme

# ── Liquibase ─────────────────────────────────────────────────────────────────
# Contexts control which changesets run. "prod" and "dev" are the only defined contexts.
# Set to "dev" to also run seed data changesets (if any are added later).
LIQUIBASE_CONTEXTS=prod

# ── Bootstrap admin ───────────────────────────────────────────────────────────
# BCrypt hash of the initial admin password (used by changeset 007).
# Change the admin password immediately after first login.
#
# Generate (cost 12, production):
#   htpasswd -bnBC 12 "" yourpassword | tr -d ':\n'
#
# Generate (cost 4, faster for local dev):
#   htpasswd -bnBC 4 "" yourpassword | tr -d ':\n'
#
# Requires apache2-utils (Debian/Ubuntu) or httpd-tools (RHEL/Fedora).
BOOTSTRAP_ADMIN_BCRYPT_HASH=$2y$04$replacethiswithyourrealbcrypthashvalue00000000000000000