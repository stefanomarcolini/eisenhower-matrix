# tm-ui-bff — Environment Variables
# Copy this file to .env and fill in your local values.
# .env is gitignored and must never be committed.

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave blank for local dev (no Redis auth required)
REDIS_PASSWORD=

# ── Session ──────────────────────────────────────────────────────────────────
# Sliding-window timeout in minutes.
SESSION_TIMEOUT_MINUTES=30

# ── Core API ─────────────────────────────────────────────────────────────────
# Internal URL of the Core API (never exposed to the browser).
# In local dev with docker-compose: http://core-api:8080
# When running both services standalone locally: http://localhost:8081
CORE_API_BASE_URL=http://localhost:8081

# ── OAuth2 ───────────────────────────────────────────────────────────────────
# Not required for local dev — mock-oauth2 server handles Google and Microsoft.
# Set real credentials only for testing against live IdPs.
# "disabled" prevents Spring Security from registering the client (won't crash on missing values).
GOOGLE_CLIENT_ID=disabled
GOOGLE_CLIENT_SECRET=disabled
MICROSOFT_CLIENT_ID=disabled
MICROSOFT_CLIENT_SECRET=disabled

# ── Application ──────────────────────────────────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev