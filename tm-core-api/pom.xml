<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.tm</groupId>
    <artifactId>eisenhower-matrix-repository</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>tm-core-api</artifactId>
  <packaging>jar</packaging>
  <description>Task Manager — Core API service (business logic and data persistence)</description>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Versions not managed by the Spring Boot BOM -->
    <totp.version>1.7.1</totp.version>
    <logstash.version>7.4</logstash.version>
    <bucket4j.version>8.7.0</bucket4j.version>
    <openapi-generator.version>7.4.0</openapi-generator.version>
    <wiremock.version>4.2.1</wiremock.version>

    <!-- Docker image used by integration tests (CODING_PATTERNS.md guardrail §3).
         Override at CI time: mvn verify -Dpostgresql.test.image=postgres:18-alpine -->
    <postgresql.test.image>postgres:17-alpine</postgresql.test.image>
         Override at CI time (Linux): mvn test -Ddocker.host=unix:///var/run/docker.sock -->
    <docker.host>npipe:////./pipe/docker_engine</docker.host>

    <!-- Override managed Testcontainers: 1.19.x sends Docker API v1.32 which is rejected
         by Docker Engine 29.x (requires >=1.41). 1.20.x uses docker-java 3.4.x that negotiates
         the correct API version. Spring Boot BOM override is safe — only affects test scope. -->
    <testcontainers.version>1.20.6</testcontainers.version>

    <postgresql.version>42.7.7</postgresql.version>
    <jackson-bom.version>3.1.0</jackson-bom.version>
    <tomcat-embed-core.version>11.0.20</tomcat-embed-core.version>
    <spring-security-web.version>7.0.4</spring-security-web.version>
    <jcommander.version>3.0</jcommander.version>
    <commons-compress.version>1.28.0</commons-compress.version>
    <javase.version>3.5.4</javase.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.security</groupId>
        <artifactId>spring-security-web</artifactId>
        <version>${spring-security-web.version}</version>
        <scope>compile</scope>
      </dependency>
      <dependency>
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-core</artifactId>
        <version>${tomcat-embed-core.version}</version>
        <scope>compile</scope>
      </dependency>
      <dependency>
        <groupId>org.jcommander</groupId>
        <artifactId>jcommander</artifactId>
        <version>${jcommander.version}</version>
        <scope>runtime</scope>
      </dependency>
      <dependency>
        <groupId>com.google.zxing</groupId>
        <artifactId>javase</artifactId>
        <version>${javase.version}</version>
        <scope>compile</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-compress</artifactId>
        <version>${commons-compress.version}</version>
        <scope>compile</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- ── Spring Boot starters ─────────────────────────────────────────────── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <!-- JWT validation (HS256). Pin algorithm explicitly — see CODING_PATTERNS.md §15 -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- ── Database ──────────────────────────────────────────────────────────── -->
    <dependency>
      <!-- JDBC driver — version managed by Spring Boot BOM -->
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- ── Utilities ─────────────────────────────────────────────────────────── -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- TOTP / MFA — MIT licence -->
    <dependency>
      <groupId>dev.samstevens.totp</groupId>
      <artifactId>totp</artifactId>
      <version>${totp.version}</version>
    </dependency>

    <!-- Structured JSON logging (prod) — Apache 2.0 -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>${logstash.version}</version>
    </dependency>

    <!-- Rate limiting — Apache 2.0 (core module only; enterprise module is commercial) -->
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j-core</artifactId>
      <version>${bucket4j.version}</version>
    </dependency>

    <!-- ── Test ──────────────────────────────────────────────────────────────── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Testcontainers auto-configuration via @ServiceConnection -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- WireMock for stubbing outbound HTTP in integration tests — Apache 2.0 -->
    <dependency>
      <groupId>org.wiremock.integrations</groupId>
      <artifactId>wiremock-spring-boot</artifactId>
      <version>${wiremock.version}</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>

      <!-- OpenAPI code generation — delegate pattern (CODING_PATTERNS.md §1) -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/api-spec/openapi.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <configOptions>
                <delegatePattern>true</delegatePattern>
                <useSpringBoot3>true</useSpringBoot3>
                <apiPackage>com.tm.core.web.api</apiPackage>
                <modelPackage>com.tm.core.web.model</modelPackage>
                <interfaceOnly>false</interfaceOnly>
                <useBeanValidation>true</useBeanValidation>
                <!-- Suppress all documentation/nullable deps from generated code.
                     The YAML spec is the source of truth; no Springdoc/Swagger at runtime.
                     Only generate the supporting files actually needed at compile/runtime;
                     SpringDocConfiguration.java requires swagger-models and is excluded. -->
                <useSwaggerAnnotations>false</useSwaggerAnnotations>
                <openApiNullable>false</openApiNullable>
                <documentationProvider>none</documentationProvider>
                <supportingFilesToGenerate>ApiUtil.java,EnumConverterConfiguration.java,RFC3339DateFormat.java</supportingFilesToGenerate>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Spring Boot Maven plugin — mvn spring-boot:test-run for local dev -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- OpenAPI generator emits its own OpenApiGeneratorApplication; pin ours explicitly -->
          <mainClass>com.tm.core.CoreApiApplication</mainClass>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- JUnit 5 runner — passes postgresql.test.image to test JVM (guardrail §3) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Pass Docker socket to forked JVM — required for Testcontainers on Windows/Rancher Desktop.
               API_VERSION (docker-java env var) forces Docker API v1.41 (Engine 29.x minimum is 1.41).
               api.version covers the system-property read path in DefaultDockerClientConfig. -->
          <environmentVariables>
            <DOCKER_HOST>${docker.host}</DOCKER_HOST>
            <API_VERSION>1.41</API_VERSION>
          </environmentVariables>
          <systemPropertyVariables>
            <postgresql.test.image>${postgresql.test.image}</postgresql.test.image>
            <api.version>1.41</api.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>

    </plugins>
  </build>

</project>