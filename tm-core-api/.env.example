# tm-core-api — Environment Variables
# Copy this file to .env and fill in your local values.
# .env is gitignored and must never be committed.

# ── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskmanager
DB_USERNAME=tm
DB_PASSWORD=changeme

# ── JWT ─────────────────────────────────────────────────────────────────────
# Secret used to sign and verify app-issued JWTs (HS256, min 32 bytes, Base64).
# Generate: openssl rand -base64 32
INTERNAL_JWT_SECRET=your-base64-encoded-secret-here

# Lifetime of an app JWT in minutes. BFF refreshes within 2 min of expiry.
JWT_EXPIRY_MINUTES=15

# ── MFA ─────────────────────────────────────────────────────────────────────
# AES-256 key used to encrypt TOTP secrets at rest (Base64, 32 bytes).
# Generate: openssl rand -base64 32
MFA_ENCRYPTION_KEY=your-base64-encoded-key-here

# ── Password policy ─────────────────────────────────────────────────────────
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_AGE_WARNING_DAYS=80
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=1

# ── Email / SMTP ─────────────────────────────────────────────────────────────
EMAIL_FROM_ADDRESS=noreply@task-manager.io
EMAIL_FROM_NAME=Task Manager
# Local dev: Mailpit (no credentials, no TLS)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_ENABLED=false

# ── Application ──────────────────────────────────────────────────────────────
# Public base URL used to build password-reset links in emails.
APP_BASE_URL=http://localhost:8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev